$(document).ready(function(){
     let addClassFunction = function () {
        const formSearch = $(this).closest('.form-search');
        if ($(this).val().trim() !== '') {
            formSearch.addClass('has-text');
        } else {
            formSearch.removeClass('has-text');
        }
    }

    $('.form-search input').on('input',addClassFunction);

    $('.form-search input').each(function () {
        addClassFunction.call(this);
    });
     

})
